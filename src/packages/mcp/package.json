{
  "name": "@mastishk/mcp",
  "version": "0.3.0",
  "description": "MCP server exposing Mastishk memory tools to Claude, Cursor, and Windsurf.",
  "license": "Apache-2.0",
  "author": "Karan Sharma <karansharma1732@gmail.com>",
  "homepage": "https://mastishk.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/mastishk-ai/mastishk.git",
    "directory": "src/packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/mastishk-ai/mastishk/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "memory",
    "mcp",
    "claude",
    "cursor",
    "windsurf",
    "llm",
    "model-context-protocol",
    "mastishk"
  ],
  "type": "module",
  "bin": {
    "mastishk-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mastishk/core": "0.3.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "engines": {
